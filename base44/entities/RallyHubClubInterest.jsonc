{
  "name": "RallyHubClubInterest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "listing_slug": {
      "type": "string"
    },
    "club_name": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "interest_type": {
      "type": "string",
      "enum": [
        "demo",
        "information",
        "notify"
      ],
      "default": "notify"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "contacted",
        "closed"
      ],
      "default": "waiting"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "listing_slug",
    "club_name",
    "contact_email",
    "interest_type",
    "status",
    "submitted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
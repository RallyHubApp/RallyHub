{
  "name": "DuprUatSubmission",
  "type": "object",
  "properties": {
    "identifier": {
      "type": "string"
    },
    "match_code": {
      "type": "string"
    },
    "hashed_match_code": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "updated",
        "deleted",
        "needs_reconciliation"
      ]
    },
    "request_hash": {
      "type": "string"
    },
    "last_request_id": {
      "type": "string"
    },
    "submitted_by_user_id": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "identifier",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "KotcSessionBroadcast",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "share_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "removed"
      ],
      "default": "published"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_by_user_id": {
      "type": "string"
    },
    "expiry_mode": {
      "type": "string",
      "enum": [
        "manual",
        "event_start",
        "30m",
        "60m",
        "120m",
        "custom"
      ],
      "default": "manual"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_recipient_count": {
      "type": "number",
      "default": 0
    },
    "email_sent_count": {
      "type": "number",
      "default": 0
    },
    "email_failed_count": {
      "type": "number",
      "default": 0
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "title",
    "message",
    "status",
    "published_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "InterclubRegistrationToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "challenge_event_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "side": {
      "type": "string",
      "enum": [
        "club_a",
        "club_b"
      ]
    },
    "token": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "challenge_event_id",
    "tournament_id",
    "side",
    "token",
    "active",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
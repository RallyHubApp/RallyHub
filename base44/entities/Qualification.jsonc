{
  "name": "Qualification",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "qualification_type": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "governing_body": {
      "type": "string"
    },
    "award_date": {
      "type": "string",
      "format": "date"
    },
    "certificate_number": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "verified",
        "expired"
      ]
    },
    "document_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "person_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
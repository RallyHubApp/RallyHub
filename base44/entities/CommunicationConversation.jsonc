{
  "name": "CommunicationConversation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "source_module": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "participant_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assigned_to_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending",
        "resolved",
        "closed"
      ]
    },
    "priority": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "subject",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
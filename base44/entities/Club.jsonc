{
  "name": "Club",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Owning Tenant ID"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "archived"
      ],
      "default": "active"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Dublin"
    },
    "public_contact_email": {
      "type": "string"
    },
    "logo_url": {
      "type": "string",
      "description": "Club logo used across RallyHub tenant/player/event surfaces"
    },
    "primary_colour": {
      "type": "string",
      "description": "Primary club brand colour (prefer CSS hex, e.g. #2563eb)"
    },
    "secondary_colour": {
      "type": "string",
      "description": "Secondary club brand colour (prefer CSS hex, e.g. #facc15)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "slug",
    "status",
    "timezone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
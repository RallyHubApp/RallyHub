{
  "name": "EventSavedItem",
  "type": "object",
  "properties": {
    "tournament_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "planning",
        "booked",
        "past"
      ],
      "default": "saved"
    },
    "remind_registration_open": {
      "type": "boolean",
      "default": false
    },
    "remind_registration_closing": {
      "type": "boolean",
      "default": false
    },
    "remind_one_week": {
      "type": "boolean",
      "default": false
    },
    "remind_one_day": {
      "type": "boolean",
      "default": false
    },
    "last_seen_event_updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tournament_id",
    "user_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.user_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}
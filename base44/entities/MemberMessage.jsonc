{
  "name": "MemberMessage",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "member",
        "chairperson"
      ]
    },
    "sender_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_by_member_at": {
      "type": "string",
      "format": "date-time"
    },
    "read_by_chair_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "thread_id",
    "sender_user_id",
    "sender_role",
    "body",
    "sent_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
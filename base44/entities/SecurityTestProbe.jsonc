{
  "name": "SecurityTestProbe",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "secret_marker": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "label"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
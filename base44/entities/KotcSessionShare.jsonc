{
  "name": "KotcSessionShare",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "visible_tabs_json": {
      "type": "string"
    },
    "scoring_access": {
      "type": "string",
      "enum": [
        "off",
        "read_only",
        "verified_players",
        "open_players"
      ],
      "default": "read_only"
    },
    "identification_mode": {
      "type": "string",
      "enum": [
        "none",
        "host_code"
      ],
      "default": "host_code"
    },
    "event_info_json": {
      "type": "string"
    },
    "player_link_email_recipient_count": {
      "type": "number",
      "default": 0
    },
    "player_link_email_sent_count": {
      "type": "number",
      "default": 0
    },
    "player_link_email_failed_count": {
      "type": "number",
      "default": 0
    },
    "player_link_email_sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "token",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
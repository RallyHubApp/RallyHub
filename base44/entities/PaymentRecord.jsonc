{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "club_membership_id": {
      "type": "string"
    },
    "membership_season": {
      "type": "string"
    },
    "purpose_type": {
      "type": "string",
      "enum": [
        "membership",
        "event",
        "training",
        "booking",
        "other"
      ],
      "default": "membership"
    },
    "purpose_id": {
      "type": "string",
      "description": "Optional linked membership/event/training/booking record"
    },
    "payment_type": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "failed",
        "partially_refunded",
        "refunded",
        "refund_pending",
        "refund_failed",
        "not_required",
        "unknown"
      ]
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "provider": {
      "type": "string",
      "description": "Payment gateway/provider, e.g. sumup, stripe, square, cash"
    },
    "provider_account_id": {
      "type": "string",
      "description": "RallyHub PaymentGatewayAccount id or provider merchant account identifier"
    },
    "provider_checkout_id": {
      "type": "string"
    },
    "provider_checkout_url": {
      "type": "string"
    },
    "provider_transaction_id": {
      "type": "string",
      "description": "Authoritative provider transaction/payment id used for reconciliation and refunds"
    },
    "provider_payment_reference": {
      "type": "string"
    },
    "provider_status": {
      "type": "string"
    },
    "amount_refunded": {
      "type": "number",
      "default": 0
    },
    "last_refund_at": {
      "type": "string",
      "format": "date-time"
    },
    "sumup_checkout_id": {
      "type": "string",
      "description": "Legacy compatibility field; use provider_checkout_id for new code"
    },
    "sumup_payment_link": {
      "type": "string",
      "description": "Legacy compatibility field; use provider_checkout_url for new code"
    },
    "external_payment_reference": {
      "type": "string"
    },
    "reconciliation_status": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_row": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "person_id",
    "payment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
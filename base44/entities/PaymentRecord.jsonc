{
  "name": "PaymentRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "club_membership_id": {
      "type": "string"
    },
    "membership_season": {
      "type": "string"
    },
    "payment_type": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending",
        "failed",
        "refunded",
        "not_required",
        "unknown"
      ]
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "sumup_checkout_id": {
      "type": "string"
    },
    "sumup_payment_link": {
      "type": "string"
    },
    "reconciliation_status": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_row": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "person_id",
    "membership_season",
    "payment_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
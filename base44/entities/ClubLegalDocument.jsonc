{
  "name": "ClubLegalDocument",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "privacy_data",
        "liability_waiver",
        "code_of_conduct",
        "health_declaration",
        "photo_video",
        "membership_terms",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "body_text": {
      "type": "string"
    },
    "consent_label": {
      "type": "string"
    },
    "required_consent": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "source_reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "document_type",
    "title",
    "version",
    "body_text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
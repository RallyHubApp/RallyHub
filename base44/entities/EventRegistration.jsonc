{
  "name": "EventRegistration",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_key": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_mobile": {
      "type": "string"
    },
    "previous_experience": {
      "type": "string"
    },
    "previous_sports": {"type":"array","items":{"type":"string"}},
    "health_declaration_applies": {"type":"boolean"},
    "medical_note": {
      "type": "string"
    },
    "registration_status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved_payment_hold",
        "confirmed",
        "cash_confirmed",
        "waitlisted",
        "cancelled",
        "expired",
        "declined"
      ]
    },
    "payment_status": {
      "type": "string"
    },
    "payment_hold_expires_at": {
      "type": "string"
    },
    "consent_evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "photo_video_consent": {
      "type": "boolean"
    },
    "operation_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "confirmed_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "payment_record_id": {
      "type": "string"
    },
    "transfer_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waitlist_position": {
      "type": "number"
    },
    "payment_checkout_id": {
      "type": "string"
    },
    "payment_checkout_url": {
      "type": "string"
    },
    "payment_transaction_id": {
      "type": "string"
    },
    "event_consent_version": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "event_id",
    "full_name",
    "email",
    "registration_status"
  ]
}

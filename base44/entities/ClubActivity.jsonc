{
  "name": "ClubActivity",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "centre_id": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "court_id": {
      "type": "string",
      "description": "Optional exact scoped Court ID; absent means full-venue reservation for conflict review"
    },
    "starts_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "registration_mode": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "host_user_id": {
      "type": "string"
    },
    "communication_template_id": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "updated_by_user_id": {
      "type": "string"
    },
    "recurrence_batch_key": {
      "type": "string",
      "description": "Source draft batch operation key; prevents overlapping creation attempts"
    },
    "recurrence_expected_count": {
      "type": "integer",
      "description": "Number of draft occurrences expected from the claimed batch"
    },
    "recurrence_batch_state": {
      "type": "string",
      "enum": [
        "creating",
        "complete",
        "needs_recovery"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "capacity": {
      "type": "integer"
    },
    "revision": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "scheduled",
        "registration_open",
        "registration_closed",
        "in_progress",
        "completed",
        "cancelled",
        "archived"
      ]
    },
    "configuration": {
      "type": "object"
    },
    "linked_event_id": {
      "type": "string",
      "description": "Explicit same-tenant same-club legacy event link; never auto-created"
    },
    "bridge_status": {
      "type": "string",
      "enum": [
        "unlinked",
        "linked_unverified",
        "verified",
        "blocked"
      ]
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "sport",
    "type",
    "title",
    "venue_id",
    "starts_at",
    "ends_at",
    "capacity",
    "revision",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
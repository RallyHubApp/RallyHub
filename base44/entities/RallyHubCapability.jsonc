{
  "name": "RallyHubCapability",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Stable capability key used by entitlement checks; never use display labels as security keys."
    },
    "display_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "tournament_type",
        "platform_function",
        "integration"
      ]
    },
    "sport_code": {
      "type": "string",
      "description": "Optional sport scope such as pickleball. Blank means platform-wide."
    },
    "status": {
      "type": "string",
      "enum": [
        "development",
        "beta",
        "active",
        "retired"
      ],
      "default": "development"
    },
    "customer_visible": {
      "type": "boolean",
      "default": false
    },
    "trial_eligible": {
      "type": "boolean",
      "default": false
    },
    "commercially_available": {
      "type": "boolean",
      "default": false
    },
    "depends_on_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "version": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "display_name",
    "category",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ClubChallengeDisplayToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "challenge_event_id": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "challenge_event_id",
    "token",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.active_tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ClubChallengeVote",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "challenge_event_id": {
      "type": "string"
    },
    "voter_identity_key": {
      "type": "string"
    },
    "voter_participant_id": {
      "type": "string"
    },
    "nominee_participant_id": {
      "type": "string"
    },
    "ballot_side": {
      "type": "string",
      "enum": [
        "club_a",
        "club_b"
      ]
    },
    "access_route": {
      "type": "string",
      "enum": [
        "logged_in",
        "guest",
        "qr"
      ]
    },
    "cast_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid": {
      "type": "boolean",
      "default": true
    },
    "rejection_reason": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "challenge_event_id",
    "voter_identity_key",
    "nominee_participant_id",
    "access_route",
    "cast_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "DirectoryClaim",
  "type": "object",
  "properties": {
    "listing_slug": {
      "type": "string"
    },
    "listing_name_snapshot": {
      "type": "string"
    },
    "claimant_user_id": {
      "type": "string"
    },
    "claimant_name": {
      "type": "string"
    },
    "claimant_role": {
      "type": "string"
    },
    "claimant_email": {
      "type": "string"
    },
    "claimant_phone": {
      "type": "string"
    },
    "claimant_message": {
      "type": "string"
    },
    "network_updates_opt_in": {
      "type": "boolean",
      "default": false
    },
    "network_updates_opted_in_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "auto_verified",
        "approved",
        "rejected",
        "revoked"
      ],
      "default": "pending"
    },
    "match_method": {
      "type": "string",
      "enum": [
        "authenticated_email",
        "trusted_invitation",
        "platform_admin_identity",
        "manual_review",
        "admin_approved"
      ]
    },
    "email_match": {
      "type": "boolean",
      "default": false
    },
    "phone_match": {
      "type": "boolean",
      "default": false
    },
    "name_match": {
      "type": "boolean",
      "default": false
    },
    "auto_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "listing_slug",
    "listing_name_snapshot",
    "claimant_user_id",
    "claimant_email",
    "claimant_phone",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
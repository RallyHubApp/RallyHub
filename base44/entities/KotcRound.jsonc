{
  "name": "KotcRound",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "round_number": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "confirmed",
        "started",
        "completed",
        "superseded",
        "abandoned"
      ],
      "default": "proposed"
    },
    "proposal_revision": {
      "type": "number",
      "default": 1
    },
    "supersedes_round_id": {
      "type": "string"
    },
    "generated_by_command_id": {
      "type": "string"
    },
    "active_court_count": {
      "type": "number"
    },
    "bench_count": {
      "type": "number"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_by_user_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "abandonment_reason": {
      "type": "string"
    },
    "engine_input_hash": {
      "type": "string"
    },
    "engine_output_hash": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "round_number",
    "status",
    "proposal_revision"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
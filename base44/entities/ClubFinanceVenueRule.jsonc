{
  "name": "ClubFinanceVenueRule",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "weekday": {
      "type": "string"
    },
    "session_label": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "cost_type": {
      "type": "string",
      "enum": [
        "per_session",
        "per_hour"
      ],
      "default": "per_session"
    },
    "cost_amount": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "default_fee_per_person": {
      "type": "number"
    },
    "income_source": {
      "type": "string",
      "enum": [
        "spond",
        "rallyhub",
        "manual"
      ],
      "default": "manual"
    },
    "spond_group_id": {
      "type": "string"
    },
    "spond_event_id": {
      "type": "string"
    },
    "directory_session_key": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "venue_name",
    "cost_type",
    "cost_amount",
    "active",
    "effective_from"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
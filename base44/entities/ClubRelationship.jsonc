{
  "name": "ClubRelationship",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "member",
        "guest",
        "waiting_list",
        "booking_only",
        "former_member",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "inactive",
        "archived"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "entry_route": {
      "type": "string",
      "enum": [
        "direct_membership",
        "waiting_list",
        "beginner_course",
        "guest_play",
        "external_club_event",
        "open_tournament",
        "booking_only",
        "other",
        "unknown"
      ]
    },
    "waiting_list_position": {
      "type": "number"
    },
    "waiting_list_status": {
      "type": "string",
      "enum": [
        "active",
        "offered",
        "deferred",
        "removed",
        "joined"
      ],
      "description": "Used only when relationship_type is waiting_list"
    },
    "waiting_list_joined_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "person_id",
    "relationship_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
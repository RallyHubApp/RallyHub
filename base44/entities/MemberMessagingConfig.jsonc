{
  "name": "MemberMessagingConfig",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "chair_user_id": {
      "type": "string"
    },
    "chair_name": {
      "type": "string"
    },
    "chair_title": {
      "type": "string"
    },
    "notification_email": {
      "type": "string"
    },
    "vapid_public_key": {
      "type": "string"
    },
    "vapid_private_key": {
      "type": "string"
    },
    "vapid_subject": {
      "type": "string"
    },
    "email_fallback_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "chair_user_id",
    "chair_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "SportProviderClubConnection",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "sport_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "dupr",
        "other"
      ]
    },
    "external_club_id": {
      "type": "string"
    },
    "connection_mode": {
      "type": "string",
      "enum": [
        "manual_csv",
        "api"
      ],
      "default": "manual_csv"
    },
    "status": {
      "type": "string",
      "enum": [
        "configured",
        "pending",
        "connected",
        "disabled"
      ],
      "default": "configured"
    },
    "external_role": {
      "type": "string",
      "description": "Provider-side role held by the connected RallyHub operator, e.g. director/organizer"
    },
    "capabilities_json": {
      "type": "string",
      "description": "Provider capability snapshot; never stores passwords, MFA secrets or raw access tokens"
    },
    "last_imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "sport_id",
    "provider",
    "external_club_id",
    "connection_mode",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "CommunicationEvent",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "delivery_attempt_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_event_id": {
      "type": "string"
    },
    "actor_user_id": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }

{
  "type": "object",
  "properties": {
    "event_category": {
      "type": "string"
    },
    "event_start_time": {
      "type": "string"
    },
    "event_end_time": {
      "type": "string"
    },
    "event_image_url": {
      "type": "string"
    },
    "event_internal_info": {
      "type": "string"
    },
    "event_contact": {
      "type": "string"
    },
    "event_registration_url": {
      "type": "string"
    },
    "event_member_visible": {
      "type": "boolean",
      "default": false
    },
    "event_public_visible": {
      "type": "boolean",
      "default": false
    },
    "event_publish_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "event_published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "required": [],
  "name": "Tournament"
}
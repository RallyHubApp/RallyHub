{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.host_club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.host_club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  },
  "required": []
}
{
  "name": "Tournament",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "host_club_id": {
      "type": "string"
    },
    "inter_club": {
      "type": "boolean"
    },
    "clubs_involved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_players": {
      "type": [
        "number",
        "null"
      ]
    },
    "partnership_type": {
      "type": "string"
    },
    "skill_range_min": {
      "type": [
        "number",
        "null"
      ]
    },
    "skill_range_max": {
      "type": [
        "number",
        "null"
      ]
    },
    "counts_toward_leaderboard": {
      "type": "boolean"
    },
    "prize_info": {
      "type": "string"
    },
    "roster_status": {
      "type": "string"
    },
    "roster_locked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finalised_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "partner_pairs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "kotc_last_import_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "kotc_session_venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "kotc_player_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kotc_guest_roster": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "kotc_state": {
      "type": [
        "object",
        "null"
      ]
    },
    "kotc_num_courts": {
      "type": [
        "number",
        "null"
      ]
    },
    "kotc_num_rounds": {
      "type": [
        "number",
        "null"
      ]
    },
    "kotc_current_round": {
      "type": [
        "number",
        "null"
      ]
    },
    "kotc_score_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "kotc_spond_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kotc_spond_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kotc_last_imported_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_category": {
      "type": "string"
    },
    "event_slug": {
      "type": "string"
    },
    "event_start_time": {
      "type": "string"
    },
    "event_end_time": {
      "type": "string"
    },
    "event_image_url": {
      "type": "string"
    },
    "event_image_position_x": {
      "type": "number",
      "default": 50
    },
    "event_image_position_y": {
      "type": "number",
      "default": 50
    },
    "event_image_zoom": {
      "type": "number",
      "default": 1
    },
    "event_card_image_url": {
      "type": "string"
    },
    "event_card_position_x": {
      "type": "number",
      "default": 50
    },
    "event_card_position_y": {
      "type": "number",
      "default": 50
    },
    "event_card_zoom": {
      "type": "number",
      "default": 1
    },
    "event_image_original_url": {
      "type": "string"
    },
    "event_image_source_type": {
      "type": "string"
    },
    "event_internal_info": {
      "type": "string"
    },
    "event_contact": {
      "type": "string"
    },
    "event_registration_url": {
      "type": "string"
    },
    "event_registration_mode": {
      "type": "string",
      "enum": [
        "external",
        "rallyhub",
        "contact",
        "none"
      ]
    },
    "event_registration_open_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event_registration_close_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "event_fee_text": {
      "type": "string"
    },
    "event_fee_amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_currency": {
      "type": "string"
    },
    "event_capacity": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_waitlist_enabled": {
      "type": "boolean",
      "default": false
    },
    "event_public_summary": {
      "type": "string"
    },
    "event_county": {
      "type": "string"
    },
    "event_country": {
      "type": "string"
    },
    "event_indoor_outdoor": {
      "type": "string",
      "enum": [
        "indoor",
        "outdoor",
        "mixed",
        ""
      ]
    },
    "event_levels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_age_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_schedule": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "event_eligibility": {
      "type": "string"
    },
    "event_player_info": {
      "type": "string"
    },
    "event_fees_cancellation": {
      "type": "string"
    },
    "event_source_url": {
      "type": "string"
    },
    "event_map_url": {
      "type": "string"
    },
    "event_latitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_longitude": {
      "type": [
        "number",
        "null"
      ]
    },
    "event_featured_public": {
      "type": "boolean",
      "default": false
    },
    "event_verified_organiser": {
      "type": "boolean",
      "default": false
    },
    "event_member_visible": {
      "type": "boolean",
      "default": false
    },
    "event_public_visible": {
      "type": "boolean",
      "default": false
    },
    "event_featured_member": {
      "type": "boolean",
      "default": false
    },
    "event_publish_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "event_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.host_club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.host_club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
{
  "name": "AnnouncementTemplate",
  "type": "object",
  "properties": {
    "scope_type": {
      "type": "string",
      "enum": [
        "platform",
        "tenant"
      ],
      "default": "platform"
    },
    "tenant_id": {
      "type": "string"
    },
    "module": {
      "type": "string",
      "enum": [
        "shared",
        "kotc",
        "interclub",
        "tournament",
        "league",
        "ladder",
        "other"
      ]
    },
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "trigger_description": {
      "type": "string"
    },
    "default_text": {
      "type": "string",
      "maxLength": 1000
    },
    "custom_text": {
      "type": "string",
      "maxLength": 1000
    },
    "mode": {
      "type": "string",
      "enum": [
        "default",
        "custom"
      ],
      "default": "default"
    },
    "default_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this announcement is enabled when reset to the RallyHub default"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "variables_help": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "scope_type",
    "module",
    "key",
    "label",
    "default_text",
    "mode",
    "enabled"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
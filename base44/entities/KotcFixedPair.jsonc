{
  "name": "KotcFixedPair",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "pair_name": {
      "type": "string"
    },
    "participant1_id": {
      "type": "string"
    },
    "participant2_id": {
      "type": "string"
    },
    "seed_rank": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "withdrawn",
        "substituted"
      ],
      "default": "active"
    },
    "replacement_pair_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "participant1_id",
    "participant2_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
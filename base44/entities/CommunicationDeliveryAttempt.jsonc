{
  "name": "CommunicationDeliveryAttempt",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_message_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "sent",
        "accepted",
        "delivered",
        "opened",
        "clicked",
        "action_completed",
        "soft_bounce",
        "hard_bounce",
        "failed",
        "suppressed",
        "cancelled",
        "complaint",
        "unsubscribed"
      ]
    },
    "attempt_number": {
      "type": "number",
      "default": 1
    },
    "idempotency_key": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "queued_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "clicked_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "campaign_id",
    "recipient_id",
    "channel",
    "status",
    "idempotency_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
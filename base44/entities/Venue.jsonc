{
  "name": "Venue",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "hourly_hire_rate": {
      "type": "number",
      "description": "Default venue hire cost per hour for club finance calculations."
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "finance_tracking_enabled": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "wifi_ssid": {
      "type": "string",
      "description": "Optional venue Wi-Fi network name for event operations."
    },
    "wifi_password": {
      "type": "string",
      "description": "Optional venue Wi-Fi password for event operations and event packs."
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "name",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
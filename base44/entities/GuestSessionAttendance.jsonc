{
  "name": "GuestSessionAttendance",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_link_id": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "attended",
        "no_show",
        "cancelled",
        "unconfirmed"
      ]
    },
    "marked_by_user_id": {
      "type": "string"
    },
    "marked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_link_id",
    "booking_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
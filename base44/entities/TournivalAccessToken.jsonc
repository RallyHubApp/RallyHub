{
  "name": "TournivalAccessToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "token_hash": {
      "type": "string"
    },
    "token_type": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "registration_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "revoked_at": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "last_used_at": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "tournament_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

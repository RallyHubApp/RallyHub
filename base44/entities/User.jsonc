{
  "type": "object",
  "properties": {
    "kotc_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "host",
        "player"
      ],
      "default": "player",
      "description": "Legacy King of the Court permission role",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Platform account approval status",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "active_tenant_id": {
      "type": "string",
      "description": "Server-controlled active RallyHub Tenant security context",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "active_club_id": {
      "type": "string",
      "description": "Server-controlled active RallyHub Club security context",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "active_tenant_role": {
      "type": "string",
      "enum": [
        "owner",
        "admin"
      ],
      "description": "Server-controlled active Tenant role",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "active_club_role": {
      "type": "string",
      "enum": [
        "club_admin",
        "member"
      ],
      "description": "Server-controlled active Club permission bundle",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "security_context_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last server-verified security context change",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "signup_notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-controlled timestamp used to prevent repeated signup-notification email credit usage",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [],
  "name": "User"
}
{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "kotc_role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "host",
        "player"
      ],
      "default": "player",
      "description": "Legacy King of the Court permission role"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Platform account approval status"
    },
    "active_tenant_id": {
      "type": "string",
      "description": "Server-controlled active RallyHub Tenant security context"
    },
    "active_club_id": {
      "type": "string",
      "description": "Server-controlled active RallyHub Club security context"
    },
    "active_tenant_role": {
      "type": "string",
      "enum": [
        "owner",
        "admin"
      ],
      "description": "Server-controlled active Tenant role"
    },
    "active_club_role": {
      "type": "string",
      "enum": [
        "club_admin",
        "member"
      ],
      "description": "Server-controlled active Club permission bundle"
    },
    "security_context_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last server-verified security context change"
    }
  },
  "required": []
}
{
  "name": "KotcSessionTemplate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "venue_id": {
      "type": "string"
    },
    "usual_start_time": {
      "type": "string"
    },
    "planned_duration_minutes": {
      "type": "number"
    },
    "venue_court_limit": {
      "type": "number"
    },
    "max_registrations": {
      "type": "number"
    },
    "planned_rounds": {
      "type": "number"
    },
    "partnership_mode": {
      "type": "string",
      "enum": [
        "rotating_doubles",
        "fixed_doubles",
        "singles"
      ],
      "default": "rotating_doubles"
    },
    "scoring_mode": {
      "type": "string",
      "enum": [
        "timed",
        "first_to"
      ],
      "default": "timed"
    },
    "score_target": {
      "type": "number"
    },
    "win_by_two": {
      "type": "boolean",
      "default": false
    },
    "score_cap": {
      "type": "number"
    },
    "play_minutes": {
      "type": "number"
    },
    "changeover_minutes": {
      "type": "number"
    },
    "seeding_mode": {
      "type": "string",
      "enum": [
        "internal_rating",
        "dupr",
        "manual",
        "previous_kotc",
        "random_seeded"
      ],
      "default": "manual"
    },
    "fairness_policy_json": {
      "type": "string",
      "description": "Versioned fairness policy configuration JSON"
    },
    "leaderboard_policy_json": {
      "type": "string",
      "description": "Versioned leaderboard and tie-break configuration JSON"
    },
    "court1_champions_enabled": {
      "type": "boolean",
      "default": true
    },
    "dupr_export_enabled": {
      "type": "boolean",
      "default": false
    },
    "engine_version": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "name",
    "status",
    "partnership_mode",
    "scoring_mode"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
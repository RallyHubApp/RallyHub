{
  "name": "RallyHubPlanCapability",
  "type": "object",
  "properties": {
    "plan_key": {
      "type": "string"
    },
    "capability_key": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "default_limits_json": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plan_key",
    "capability_key",
    "enabled"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
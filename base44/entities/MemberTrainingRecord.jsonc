{
  "name": "MemberTrainingRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "training_name": {
      "type": "string"
    },
    "training_type": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "training_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "booked",
        "attended",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "completed"
    },
    "level": {
      "type": "string"
    },
    "certificate_reference": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "season": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "member_id",
    "training_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
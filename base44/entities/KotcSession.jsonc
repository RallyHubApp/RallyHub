{
  "name": "KotcSession",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "tournament_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "paused",
        "completed",
        "finalised",
        "abandoned",
        "cancelled"
      ],
      "default": "draft"
    },
    "venue_id": {
      "type": "string"
    },
    "custom_location": {
      "type": "string"
    },
    "scheduled_start": {
      "type": "string",
      "format": "date-time"
    },
    "planned_duration_minutes": {
      "type": "number"
    },
    "actual_first_round_start": {
      "type": "string",
      "format": "date-time"
    },
    "actual_session_end": {
      "type": "string",
      "format": "date-time"
    },
    "venue_court_limit": {
      "type": "number"
    },
    "available_court_limit": {
      "type": "number"
    },
    "max_registrations": {
      "type": "number"
    },
    "planned_rounds": {
      "type": "number"
    },
    "partnership_mode": {
      "type": "string",
      "enum": [
        "rotating_doubles",
        "fixed_doubles",
        "phased_doubles",
        "singles"
      ],
      "default": "rotating_doubles"
    },
    "round1_bench_priority": {
      "type": "string",
      "enum": [
        "latest_registration",
        "fairness_engine",
        "manual"
      ],
      "default": "manual"
    },
    "scoring_mode": {
      "type": "string",
      "enum": [
        "timed",
        "first_to"
      ],
      "default": "timed"
    },
    "score_target": {
      "type": "number"
    },
    "win_by_two": {
      "type": "boolean",
      "default": false
    },
    "score_cap": {
      "type": "number"
    },
    "play_minutes": {
      "type": "number"
    },
    "changeover_minutes": {
      "type": "number"
    },
    "seeding_mode": {
      "type": "string",
      "enum": [
        "internal_rating",
        "dupr",
        "manual",
        "previous_kotc",
        "random_seeded"
      ],
      "default": "manual"
    },
    "random_seed": {
      "type": "string"
    },
    "fairness_policy_json": {
      "type": "string"
    },
    "leaderboard_policy_json": {
      "type": "string"
    },
    "court1_champions_enabled": {
      "type": "boolean",
      "default": true
    },
    "dupr_export_enabled": {
      "type": "boolean",
      "default": false
    },
    "engine_version": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    },
    "template_snapshot_json": {
      "type": "string"
    },
    "revision": {
      "type": "number",
      "default": 0
    },
    "current_round_number": {
      "type": "number",
      "default": 0
    },
    "current_round_id": {
      "type": "string"
    },
    "last_command_id": {
      "type": "string"
    },
    "finish_after_current_round": {
      "type": "boolean",
      "default": false
    },
    "demo_mode": {
      "type": "boolean",
      "default": false,
      "description": "Read-only demonstration session retained for display/training"
    },
    "exclude_from_aggregates": {
      "type": "boolean",
      "default": false,
      "description": "Exclude this session from KOTC historical aggregates and future-history seeding"
    },
    "finalised_at": {
      "type": "string",
      "format": "date-time"
    },
    "finalised_by_user_id": {
      "type": "string"
    },
    "abandonment_reason": {
      "type": "string"
    },
    "created_from_session_id": {
      "type": "string",
      "description": "Source session when cloned"
    },
    "timer_state_json": {
      "type": "string",
      "description": "Persisted KOTC round timer state for refresh/recovery"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "name",
    "status",
    "partnership_mode",
    "scoring_mode",
    "engine_version",
    "rules_version"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "RallyHubSubscription",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "plan_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "payment_due",
        "grace",
        "suspended",
        "cancelled",
        "expired"
      ],
      "default": "trial"
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "renews_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "grace_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "price_amount": {
      "type": "number"
    },
    "billing_interval": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "provider_subscription_id": {
      "type": "string"
    },
    "payment_gateway_account_id": {
      "type": "string",
      "description": "RallyHub PlatformPaymentGatewayAccount id for RallyHub commercial billing. Must never reference a tenant/club PaymentGatewayAccount."
    },
    "converted_from_trial_application_id": {
      "type": "string"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "plan_key",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
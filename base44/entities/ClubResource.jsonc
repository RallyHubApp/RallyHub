{
  "name": "ClubResource",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 220
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "category": {
      "type": "string",
      "maxLength": 120
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "video",
        "guide",
        "document",
        "link",
        "policy",
        "coaching",
        "other"
      ],
      "default": "link"
    },
    "url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "sport_key": {
      "type": "string",
      "maxLength": 120
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "title",
    "category",
    "resource_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
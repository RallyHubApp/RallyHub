{
  "name": "ClubResource",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 220
    },
    "description": {
      "type": "string",
      "maxLength": 3000
    },
    "category": {
      "type": "string",
      "maxLength": 120
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "video",
        "guide",
        "document",
        "link",
        "policy",
        "coaching",
        "other"
      ],
      "default": "link"
    },
    "url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "external_link",
        "uploaded_file"
      ],
      "default": "external_link"
    },
    "file_name": {
      "type": "string",
      "maxLength": 260
    },
    "sport_key": {
      "type": "string",
      "maxLength": 120
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "title",
    "category",
    "resource_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
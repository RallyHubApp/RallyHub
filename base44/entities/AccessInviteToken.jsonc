{
  "name": "AccessInviteToken",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "guest_booking",
        "membership_application"
      ]
    },
    "token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "session_link_id": {
      "type": "string"
    },
    "membership_config_id": {
      "type": "string"
    },
    "access_request_id": {
      "type": "string"
    },
    "intended_email": {
      "type": "string"
    },
    "intended_mobile": {
      "type": "string"
    },
    "intended_name": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_user_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "purpose",
    "token",
    "status",
    "created_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
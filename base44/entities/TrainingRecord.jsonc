{
  "name": "TrainingRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "training_name": {
      "type": "string"
    },
    "level_category": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "coach_instructor": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "venue": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "attended",
        "completed",
        "not_completed",
        "expired"
      ]
    },
    "result": {
      "type": "string"
    },
    "certificate_number": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "source_system": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "person_id",
    "training_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
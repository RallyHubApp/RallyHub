{
  "name": "ClubAccessRestriction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email_key": {
      "type": "string"
    },
    "mobile_key": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all_bookings",
        "membership_only",
        "guest_only"
      ],
      "default": "all_bookings"
    },
    "reason_code": {
      "type": "string"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "committee_reference": {
      "type": "string"
    },
    "private_notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "person_id",
    "status",
    "scope",
    "reason_code"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
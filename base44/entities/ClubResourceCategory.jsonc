{
  "name": "ClubResourceCategory",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "icon_key": {
      "type": "string",
      "maxLength": 60
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "name",
    "sort_order",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "user"
              }
            },
            {
              "data.tenant_id": "{{user.data.active_tenant_id}}"
            },
            {
              "data.club_id": "{{user.data.active_club_id}}"
            },
            {
              "user_condition": {
                "data.approval_status": "approved"
              }
            },
            {
              "user_condition": {
                "data.active_club_role": "club_admin"
              }
            }
          ]
        }
      ]
    }
  }
}
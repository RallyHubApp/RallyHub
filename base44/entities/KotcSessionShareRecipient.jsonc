{
  "name": "KotcSessionShareRecipient",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "share_id": {
      "type": "string"
    },
    "player_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "error_message": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "share_id",
    "delivery_status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "RallyHubCommercialPlan",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "retired"
      ],
      "default": "draft"
    },
    "description": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "price_amount": {
      "type": "number"
    },
    "billing_interval": {
      "type": "string",
      "enum": [
        "one_off",
        "monthly",
        "quarterly",
        "annual",
        "custom"
      ]
    },
    "customer_visible": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "display_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
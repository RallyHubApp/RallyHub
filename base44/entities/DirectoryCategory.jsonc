{
  "name": "DirectoryCategory",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "plural_label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "club_first": {
      "type": "boolean",
      "default": false
    },
    "location_mode": {
      "type": "string",
      "enum": [
        "county",
        "service_area",
        "none"
      ],
      "default": "none"
    },
    "show_public_filter": {
      "type": "boolean",
      "default": true
    },
    "show_listing_form": {
      "type": "boolean",
      "default": true
    },
    "allow_player_notifications": {
      "type": "boolean",
      "default": true
    },
    "commercial_listing": {
      "type": "boolean",
      "default": false
    },
    "entitlement_mode": {
      "type": "string",
      "enum": [
        "free",
        "future_paid"
      ],
      "default": "free"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "label",
    "plural_label",
    "active",
    "sort_order",
    "location_mode",
    "show_public_filter",
    "show_listing_form",
    "allow_player_notifications",
    "commercial_listing",
    "entitlement_mode"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
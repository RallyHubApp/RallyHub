        "pair_at_transition",
        "host_select_at_transition"
      ]
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_id",
    "phase_order",
    "start_round",
    "mode"
  ],
  "rls": {

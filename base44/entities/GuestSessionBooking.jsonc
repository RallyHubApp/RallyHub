{
  "name": "GuestSessionBooking",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "club_id": {
      "type": "string"
    },
    "session_link_id": {
      "type": "string"
    },
    "person_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "email_key": {
      "type": "string"
    },
    "mobile": {
      "type": "string"
    },
    "mobile_key": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_mobile": {
      "type": "string"
    },
    "medical_note": {
      "type": "string"
    },
    "waiver_version": {
      "type": "string"
    },
    "waiver_accepted": {
      "type": "boolean"
    },
    "code_of_conduct_version": {
      "type": "string"
    },
    "code_of_conduct_accepted": {
      "type": "boolean"
    },
    "privacy_notice_version": {
      "type": "string"
    },
    "privacy_acknowledged": {
      "type": "boolean"
    },
    "cancellation_policy_version": {
      "type": "string"
    },
    "cancellation_policy_accepted": {
      "type": "boolean"
    },
    "photo_video_consent": {
      "type": "string",
      "enum": [
        "yes",
        "no"
      ]
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "confirmed",
        "cash_due",
        "cancelled"
      ],
      "default": "pending_payment"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "sumup",
        "stripe",
        "square",
        "cash"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "cash_due",
        "failed",
        "expired",
        "partially_refunded",
        "refunded"
      ],
      "default": "pending"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "sumup_checkout_id": {
      "type": "string"
    },
    "sumup_checkout_url": {
      "type": "string"
    },
    "sumup_checkout_reference": {
      "type": "string"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_code": {
      "type": "string"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "guest_confirmation_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "default": "rallyhub_guest_session"
    }
  },
  "required": [
    "tenant_id",
    "club_id",
    "session_link_id",
    "full_name",
    "email",
    "email_key",
    "mobile",
    "mobile_key",
    "waiver_version",
    "waiver_accepted",
    "code_of_conduct_version",
    "code_of_conduct_accepted",
    "privacy_notice_version",
    "privacy_acknowledged",
    "cancellation_policy_version",
    "cancellation_policy_accepted",
    "photo_video_consent",
    "booking_status",
    "payment_method",
    "payment_status",
    "amount",
    "currency",
    "registered_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
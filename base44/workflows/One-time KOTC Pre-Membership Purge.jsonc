{
  "description": "One-time controlled purge of old KOTC test/event data and partial membership import before the Clare Pickleball membership-master import. Retains the 9 Sep KOTC demo and protected linked identities.",
  "name": "One-time KOTC Pre-Membership Purge",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2026-09-09T18:45:15Z",
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "one_time_kotc_pre_membership_purge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "purgeKotcPreMembership",
            "args": {
              "confirmation": "PURGE_KOTC_PRE_MEMBERSHIP_2026_09_09",
              "dryRun": false
            }
          },
          "then": "end"
        }
      }
    ]
  }
}
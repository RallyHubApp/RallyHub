ate: paused;\n}\n\n/* Mobile usability: avoid iOS form zoom and keep primary touch targets comfortable. */\n@media (max-width: 640px) {\n  input:not([type=\"checkbox\"]):not([type=\"radio\"]),\n  textarea,\n  select {\n    font-size: 16px !important;\n  }\n\n  button, a {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .glass, .glass-strong {\n    backdrop-filter: blur(14px);\n  }\n}\n\n/* Accessible scrollbar: wider and higher contrast for desktop/full-screen use. */\nhtml {\n  scrollbar-color: hsl(var(--muted-foreground)) hsl(var(--card));\n  scrollbar-width: auto;\n  overflow-y: scroll;\n  scrollbar-gutter: stable;\n}\n\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-track {\n  background: hsl(var(--card));\n}\n\n::-webkit-scrollbar-thumb {\n  background: hsl(var(--muted-foreground));\n  border: 2px solid hsl(var(--card));\n  border-radius: 999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: hsl(var(--foreground) / 0.7);\n}\n\n/* Theme-aware glass surfaces */\n.glass {\n  background: hsl(var(--card) / 0.72);\n  backdrop-filter: blur(20px);\n  border: 1px solid hsl(var(--border) / 0.72);\n}\n\n.glass-strong {\n  background: hsl(var(--card) / 0.9);\n  backdrop-filter: blur(30px);\n  border: 1px solid hsl(var(--border) / 0.9);\n}\n\n[data-theme=\"hall\"] .glass,\n[data-theme=\"hall\"] .glass-strong {\n  background: hsl(var(--card));\n  backdrop-filter: none;\n  border-width: 2px;\n}\n\n/* Hall mode prioritises instant visibility in bright sports halls. */\n[data-theme=\"hall\"] button,\n[data-theme=\"hall\"] [role=\"button\"],\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  border-width: 2px;\n}\n\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  background: hsl(var(--card));\n  color: hsl(var(--foreground));\n}\n\n[data-theme=\"hall\"] input[type=\"checkbox\"],\n[data-theme=\"hall\"] input[type=\"radio\"] {\n  min-wi
es */\n.glass {\n  background: hsl(var(--card) / 0.72);\n  backdrop-filter: blur(20px);\n  border: 1px solid hsl(var(--border) / 0.72);\n}\n\n.glass-strong {\n  background: hsl(var(--card) / 0.9);\n  backdrop-filter: blur(30px);\n  border: 1px solid hsl(var(--border) / 0.9);\n}\n\n[data-theme=\"hall\"] .glass,\n[data-theme=\"hall\"] .glass-strong {\n  background: hsl(var(--card));\n  backdrop-filter: none;\n  border-width: 2px;\n}\n\n/* Hall mode prioritises instant visibility in bright sports halls. */\n[data-theme=\"hall\"] button,\n[data-theme=\"hall\"] [role=\"button\"],\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  border-width: 2px;\n}\n\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  background: hsl(var(--card));\n  color: hsl(var(--foreground));\n}\n\n[data-theme=\"hall\"] input[type=\"checkbox\"],\n[data-theme=\"hall\"] input[type=\"radio\"] {\n  min-width: 1.15rem;\n  min-height: 1.15rem;\n  accent-color: hsl(var(--primary));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"checkbox\"] {\n  width: 1.25rem;\n  height: 1.25rem;\n  border-width: 2px;\n  border-color: hsl(var(--foreground) / 0.72);\n  background: hsl(var(--card));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"checkbox\"][data-state=\"checked\"] {\n  border-color: hsl(var(--primary));\n  background: hsl(var(--primary));\n}\n\n[data-theme=\"hall\"] [data-rally-slider-track] {\n  height: 0.5rem;\n  background: hsl(var(--foreground) / 0.22);\n}\n\n[data-theme=\"hall\"] [data-rally-slider-thumb] {\n  width: 1.25rem;\n  height: 1.25rem;\n  border-width: 3px;\n  border-color: hsl(var(--primary));\n  background: hsl(var(--card));\n  box-shadow: 0 0 0 2px hsl(var(--card));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"slider\"] {\n  min-height: 2rem;\n}\n\n[data-theme=\"hall\"] [data-rally-slider-track] {\n  height: 0.55rem;\n  background: hsl(var(--muted-foreground) / 0.32);\n}\n\n[data-theme
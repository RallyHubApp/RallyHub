in-out{\n  animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n.ease-linear{\n  animation-timing-function: linear;\n}\n.\\!running{\n  animation-play-state: running !important;\n}\n.running{\n  animation-play-state: running;\n}\n.paused{\n  animation-play-state: paused;\n}\n.\\[filter\\:none\\]{\n  filter: none;\n}\n.\\[image-rendering\\:auto\\]{\n  image-rendering: auto;\n}\n.\\[scrollbar-width\\:thin\\]{\n  scrollbar-width: thin;\n}\n\n/* Mobile usability: avoid iOS form zoom and keep primary touch targets comfortable. */\n@media (max-width: 640px) {\n  .app-mobile-viewport,\n  .app-mobile-viewport > *,\n  .app-mobile-viewport section,\n  .app-mobile-viewport article {\n    min-width: 0;\n    max-width: 100%;\n  }\n\n  .app-mobile-viewport img,\n  .app-mobile-viewport video,\n  .app-mobile-viewport canvas,\n  .app-mobile-viewport iframe {\n    max-width: 100%;\n  }\n\n  input:not([type=\"checkbox\"]):not([type=\"radio\"]),\n  textarea,\n  select {\n    font-size: 16px !important;\n  }\n\n  button, a {\n    -webkit-tap-highlight-color: transparent;\n  }\n\n  .glass, .glass-strong {\n    backdrop-filter: blur(14px);\n  }\n}\n\n/* Accessible scrollbar: wider and higher contrast for desktop/full-screen use. */\nhtml {\n  scrollbar-color: hsl(var(--muted-foreground)) hsl(var(--card));\n  scrollbar-width: auto;\n  max-width: 100%;\n  overflow-x: hidden;\n}\n\nbody,\n#root {\n  width: 100%;\n  max-width: 100%;\n  overflow-x: hidden;\n}\n\n/* Reserve a persistent scrollbar gutter only on desktop. On phones this can\n   alter the effective layout viewport and make the authenticated shell render\n   as though a wider desktop canvas exists. */\n@media (min-width: 1024px) {\n  html {\n    overflow-y: scroll;\n    scrollbar-gutter: stable;\n  }\n}\n\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-track {\n  background: hsl(var(--card));\n}\n\n::-webkit-scrollbar-thumb {\n  background: hsl(var(--muted-foreground));\n  border: 2px solid hsl(var(--card));\n  border-radius: 999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: hsl(var(--foreground) / 0.7);\n}\n\n/* Theme-aware glass surfaces */\n.glass {\n  background: hsl(var(--card) / 0.72);\n  backdrop-filter: blur(20px);\n  border: 1px solid hsl(var(--border) / 0.72);\n}\n\n.glass-strong {\n  background: hsl(var(--card) / 0.9);\n  backdrop-filter: blur(30px);\n  border: 1px solid hsl(var(--border) / 0.9);\n}\n\n[data-theme=\"hall\"] .glass,\n[data-theme=\"hall\"] .glass-strong {\n  background: hsl(var(--card));\n  backdrop-filter: none;\n  border-width: 2px;\n}\n\n/* Hall mode prioritises instant visibility in bright sports halls. */\n[data-theme=\"hall\"] button,\n[data-theme=\"hall\"] [role=\"button\"],\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  border-width: 2px;\n}\n\n[data-theme=\"hall\"] input,\n[data-theme=\"hall\"] select,\n[data-theme=\"hall\"] textarea {\n  background: hsl(var(--card));\n  color: hsl(var(--foreground));\n}\n\n[data-theme=\"hall\"] input[type=\"checkbox\"],\n[data-theme=\"hall\"] input[type=\"radio\"] {\n  min-width: 1.15rem;\n  min-height: 1.15rem;\n  accent-color: hsl(var(--primary));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"checkbox\"] {\n  width: 1.25rem;\n  height: 1.25rem;\n  border-width: 2px;\n  border-color: hsl(var(--foreground) / 0.72);\n  background: hsl(var(--card));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"checkbox\"][data-state=\"checked\"] {\n  border-color: hsl(var(--primary));\n  background: hsl(var(--primary));\n}\n\n[data-theme=\"hall\"] [data-rally-slider-track] {\n  height: 0.5rem;\n  background: hsl(var(--foreground) / 0.22);\n}\n\n[data-theme=\"hall\"] [data-rally-slider-thumb] {\n  width: 1.25rem;\n  height: 1.25rem;\n  border-width: 3px;\n  border-color: hsl(var(--primary));\n  background: hsl(var(--card));\n  box-shadow: 0 0 0 2px hsl(var(--card));\n}\n\n[data-theme=\"hall\"] [data-rally-control=\"slider\"] {\n  m